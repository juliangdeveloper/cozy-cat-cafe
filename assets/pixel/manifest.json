{
  "format": "cozy-cat-cafe-sprites",
  "version": 1,
  "notes": {
    "pixelArt": "All files are native size. Draw at 1:1 CSS px with image-rendering: pixelated; do not rescale.",
    "idleSheet": "Horizontal strip, frames left to right, loop forever with durationsMs per frame.",
    "customerKey": "colorIndex = ROSTER position + 1 (js/game.js ROSTER) = face id from runFaceColor(); use it to pick the sprite for an order.",
    "customerSizes": {
      "32": ".order-card avatar (default)",
      "28": ".order-card avatar inside @media(max-width:560px)"
    },
    "hostCat96": "victory/defeat veil (spr(\"cat_client_1\", 96))",
    "skillSizes": {
      "26": ".pow icon (.pow img, .pow .o = 26x26)"
    },
    "skillKey": "key used by renderPowers()/skillUsePrice(); inPowerbar=false means defined in js/game.js but no button today."
  },
